---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getWorkspaceRoot } from "../../lib/workspace.js";
import {
  formatHistoryTypeLabel,
  formatSessionTimestamp,
  loadWorkspaceSessionDetail,
} from "../../lib/sessions.js";

const { sessionKey } = Astro.params;
if (!sessionKey) {
  return Astro.redirect("/sessions");
}

const root = getWorkspaceRoot();
const session = await loadWorkspaceSessionDetail(root, sessionKey);
if (!session) {
  return Astro.redirect("/sessions");
}

function roleLabel(role: string): string {
  switch (role) {
    case "user":
      return "You";
    case "assistant":
      return "Agent";
    case "compaction":
      return "Compaction";
    case "branch_summary":
      return "Branch summary";
    default:
      return role;
  }
}

function roleClass(role: string): string {
  switch (role) {
    case "user":
      return "session-turn session-turn--user";
    case "assistant":
      return "session-turn session-turn--assistant";
    case "compaction":
    case "branch_summary":
      return "session-turn session-turn--summary";
    default:
      return "session-turn session-turn--custom";
  }
}

function formatJson(value: unknown): string {
  try {
    return JSON.stringify(value, null, 2);
  } catch {
    return String(value);
  }
}
---
<BaseLayout title={session.name ?? session.roleLabel}>
  <div class="breadcrumb">
    <a href="/">Explorer</a> →
    <a href="/sessions">Sessions</a> →
    {session.name ?? session.roleLabel}
  </div>

  <div class="page-intro">
    <h1>{session.name ?? session.roleLabel}</h1>
    <p class="meta">
      {session.roleId} · {formatHistoryTypeLabel(session.historyType)} · {session.messageCount} messages ·
      modified {formatSessionTimestamp(session.modified)}
    </p>
    <p class="meta break-all">Session id: {session.id}</p>
  </div>

  <div class="session-thread">
    {session.messages.length === 0 ? (
      <p class="meta">This session has no displayable messages.</p>
    ) : (
      session.messages.map((message) => (
        <article class={roleClass(message.role)}>
          <div class="session-bubble">
            <header class="session-bubble__header">
              <strong>{roleLabel(message.role)}</strong>
              <time class="meta" datetime={message.timestamp}>
                {formatSessionTimestamp(new Date(message.timestamp))}
              </time>
            </header>

            {message.reasoning || message.reasoningLocked ? (
              <details class="session-collapsible session-collapsible--reasoning">
                <summary>Reasoning</summary>
                <div class="session-collapsible__body">
                  {message.reasoning ? (
                    <pre class="session-text">{message.reasoning}</pre>
                  ) : (
                    <p class="session-muted">Reasoning is stored in encrypted provider form and is not shown here.</p>
                  )}
                </div>
              </details>
            ) : null}

            {message.toolCalls?.map((toolCall) => (
              <details class="session-collapsible session-collapsible--tool">
                <summary>
                  <span class="session-tool-call__name">{toolCall.name}</span>
                  {toolCall.resultIsError ? (
                    <span class="session-tool-call__badge session-tool-call__badge--error">error</span>
                  ) : toolCall.resultText !== undefined ? (
                    <span class="session-tool-call__badge session-tool-call__badge--ok">result</span>
                  ) : (
                    <span class="session-tool-call__badge">pending</span>
                  )}
                </summary>
                <div class="session-collapsible__body session-tool-call__details">
                  <section>
                    <h4>Call</h4>
                    <pre class="session-text">{formatJson(toolCall.arguments)}</pre>
                  </section>
                  {toolCall.resultText !== undefined ? (
                    <section>
                      <h4>Result</h4>
                      <pre class:list={["session-text", toolCall.resultIsError && "session-text--error"]}>
                        {toolCall.resultText || "(empty result)"}
                      </pre>
                    </section>
                  ) : null}
                </div>
              </details>
            ))}

            {message.text ? <pre class="session-text session-bubble__text">{message.text}</pre> : null}
          </div>
        </article>
      ))
    )}
  </div>
</BaseLayout>
